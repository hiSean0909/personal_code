# ============================================================
# 复制本文件为 .env 后填入真实值（或直接在 PowerShell 设置环境变量）
# 注意：.env 一定不要提交到 Git
# ============================================================

# 【必填】DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】默认即可，企业私有部署才改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 【可选】Web 端口，默认 7867
WEB_PORT=7867
